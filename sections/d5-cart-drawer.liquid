    font-size: 14px;
  }
  .cd-up-form-d5 button{
    max-width: 100%;
  }
  .cd-up-form-d5 select{
    padding: 0 0px;
    margin: 0;
  }
  .cd-up-form-d5 button{
    font-weight: 600;
    color: #fff;
    background:#002702;
    border: 1px solid #002702;
    outline: none;
  }
  .cd-up-form-d5 button.loading{
    opacity: .5;
    pointer-events: none;
  }
  .cd-item-discounts-d5 ul{
    display: flex;
    flex-direction: column;
    align-items: end;
    padding: 8px 0 0px;
  }
  .cd-item-discounts-d5 ul li{
    font-size: 13px;
    line-height: 1;
    font-weight: 400;
    white-space: nowrap;
  }
  .product-form__error-message-wrapper{
    display: none !important;
  }
  
  @media (max-width: 750px){
    .cd-inner-d5{
      width: 100%;
    }
    .cd-header-d5,.cd-footer-d5{
      padding: 20px;
    }
    .cd-rewards-bar-d5, .cd-item-d5, .cd-up-inner-d5{
      padding-inline: 20px;
    }
    .cd-sp-main-d5 .sp-img-d5{
      min-width: 50px;
      max-width: 50px;
      max-height: 50px;
    }
    .cd-up-img-d5{
      min-width: 80px;
      max-width: 80px;
      height: 80px;
    }
    .cd-up-item-d5{
      padding: 5px;
    }
    .cdup-carousel-btn-d5{
      width: 20px;
    }
    .cd-item-img-d5{
      max-width: 70px;
    }
    .sp-t-check-d5{
      font-size: 10px;
    }
  }
</style>
{% assign sp = section.settings.sp %}
<div class="cart-drawer-d5">
  <div class="cd-overlay-d5" close-cart-d5></div>
  <div class="cd-inner-d5">
    <div class="cd-header-d5">
      <div class="cd-heading-d5" render-d5>
        <p>
          {% comment %} Your Cart&nbsp;•&nbsp;<span class="cd-count-d5"> {{ cart.item_count }}</span> {% endcomment %}
           Buy 4, Pay for 2 <br>
           Buy 6, Pay for 3 
        </p>
      </div>
      <div class="cd-close-d5" close-cart-d5>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
          focusable="false"
          width="15"
          height="15"
          class="icon icon-close"
          fill="none"
          viewBox="0 0 18 17"
        >
          <path d="M.865 15.978a.5.5 0 00.707.707l7.433-7.431 7.579 7.282a.501.501 0 00.846-.37.5.5 0 00-.153-.351L9.712 8.546l7.417-7.416a.5.5 0 10-.707-.708L8.991 7.853 1.413.573a.5.5 0 10-.693.72l7.563 7.268-7.418 7.417z" fill="currentColor">
          </path>
        </svg>
      </div>
    </div>
    <div class="cd-content-d5">
      {% if section.settings.timer_text != blank %}
        <div class="cd-timer-main-d5">
          {% assign time = section.settings.time | append: ':00' %}
          {% capture time_content %}
          <span class="cd-timer-time-d5">{{ time }}</span>
        {% endcapture %}
          <p data-time="{{ time }}">{{ section.settings.timer_text | replace: '[[time]]', time_content }}</p>
        </div>
      {% endif %}
      <div class="cd-rewards-bar-d5">
        <div class="cd-free-shipping-bar__content-d5">
          <p class="cd-free-shipping-bar__text-d5" render-d5>
            {% if cart.item_count >= 6 %}
              You've unlocked <strong>3 FREE ITEMS</strong>
            {% elsif cart.item_count >= 2 %}
              {% assign products_needed = 6 | minus: cart.item_count %}
              You're {{ products_needed }} product{% if products_needed != 1 %}s{% endif %} away from
              <strong>3 FREE ITEMS</strong>
            {% else %}
              {% assign products_needed = 2 | minus: cart.item_count %}
              You're {{ products_needed }} product{% if products_needed != 1 %}s{% endif %} away from
              <strong>2 FREE ITEMS</strong>
            {% endif %}
          </p>
        </div>

        <div class="cd-free-shipping-bar-d5">
          <div class="cd-shipping-points-d5">
            <div class="cd-shipping-point-d5">
              <div class="cd-rw-bar-d5">
                <div
                  class="cd-free-shipping-bar__inner-d5"
                  style="width: {% if cart.item_count >= 2 %}100{% else %}{{ cart.item_count | times: 50.0 | round: 2 }}{% endif %}%;"
                ></div>
              </div>

              <div
                class="cd-free-shipping-bar__icon-d5 {% if cart.item_count >= 2 %}rewards-true{% else %}rewards-false{% endif %}"
                render-d5
                data-width="{% if cart.item_count >= 2 %}100{% else %}{{ cart.item_count | times: 50.0 | round: 2 }}{% endif %}%"
              >
                <span
                  class="cd-icon-tag-d5"
                  style="background-image:;"
                >
                  {% render 'd5-reward-icon' %}
                </span>
                <span class="cd-icon-tooltip-d5"
                  >Add any 2 items<br>
                  for FREE</span
                >
              </div>
            </div>

            <div class="cd-shipping-point-d5">
              <div class="cd-rw-bar-d5">
                <div
                  class="cd-free-shipping-bar__inner-d5"
                  style="width: {% if cart.item_count >= 6 %}100{% elsif cart.item_count <= 2 %}0{% else %}{{ cart.item_count | minus: 2 | times: 25.0 | round: 2 }}{% endif %}%;"
                ></div>
              </div>

              <div
                class="cd-free-shipping-bar__icon-d5 {% if cart.item_count >= 6 %}rewards-true{% else %}rewards-false{% endif %}"
                render-d5
                data-width="{% if cart.item_count >= 6 %}100{% elsif cart.item_count <= 2 %}0{% else %}{{ cart.item_count | minus: 2 | times: 25.0 | round: 2 }}{% endif %}%"
              >
                <span
                  class="cd-icon-tag-d5"
                  style="background-image:;"
                >
                  {% render 'd5-reward-icon' %}
                </span>
                <span class="cd-icon-tooltip-d5"
                  >Add any 3 items<br>
                  for FREE</span
                >
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="atc-loader-d5">
        <span class="item-loader-d5"></span>
      </div>
      <div
        class="cd-cart-items-d5 {% if cart.item_count == 0 %}cd-hide-upsell-d5{% endif %}"
        render-d5
        data-width="{{ percentage | round: 2 }}%"
        shipping-bar-d5
      >
        {% if cart.item_count > 0 %}
          {% for item in cart.items %}
            {% if item.product_id == sp.id %}
              {% assign shipping_protection = true %}
              {% assign sp_key = item.key %}
            {% endif %}
            <div
              class="cd-item-d5 real-item-d5 {% if item.product_id == sp.id %}hidden-line-item-d5{% endif %}"
              data-variant-id="{{ item.variant.id }}"
              data-line-item-key="{{ item.key }}"
              {% if forloop.first %}
                data-product-id="{{ item.product_id }}"
                data-variant-title="{{ item.variant.title }}"
              {% endif %}
            >
              <span class="item-loader-d5"></span>
              <div class="item-light-overlay-d5"></div>
              <div class="cd-item-img-d5" style="--aspect-ratio: {{ item.image.aspect_ratio }}">
                <a href="{{ item.url }}">
                  <img
                    src="{{ item.image |  image_url: width: 400 }}"
                    width="90"
                    height="90"
                    alt="{{ item.title }}"
                    loading="lazy"
                  >
                </a>
              </div>
              <div class="cd-item-info-d5">
                <div class="cd-title-price-d5">
                  <h4>
                    <a href="{{ item.product.url }}">{{ item.product.title }}</a>
                    <div class="cd-remove-d5 cd-qty-btn-d5 cd-remove-icon-d5">
                      {% render 'd5-delete-icon' %}
                    </div>
                  </h4>
                </div>
                {%- if item.product.has_only_default_variant == false
                  or item.properties.size != 0
                  or item.selling_plan_allocation != null
                -%}
                  <div class="cd-item-variants-d5">
                    {% if item.product.has_only_default_variant == false %}
                      {% for option in item.options_with_values %}
                        <div class="cd-otpions-d5">
                          <h5>{{ option.name }}:</h5>
                          <p>{{ option.value }}</p>
                        </div>
                      {% endfor %}
                    {% endif %}
                  </div>
                {% endif %}
                <div class="cd-qty-price-d5">
                  <div class="cd-quantity-d5">
                    {% assign qty = item.variant.inventory_management %}
                    <div class="cd-qty-btn-d5 is-loader-d5 {% if item.quantity == 1 %}cd-remove-d5{% else %}cd-minus-d5{% endif %}">
                      <span class="btn-text-d5">
                        <svg viewBox="0 0 20 20">
                          <path fill-rule="evenodd" d="M5 10c0-.414.336-.75.75-.75h8.5c.414 0 .75.336.75.75s-.336.75-.75.75h-8.5c-.414 0-.75-.336-.75-.75Z"></path>
                        </svg>
                      </span>
                      <span class="btn-loader-d5"></span>
                    </div>
                    <input
                      type="text"
                      value="{{ item.quantity }}"
                      data-max="{% if qty %}{%if item.variant.inventory_quantity > 1 %}{{ item.variant.inventory_quantity }}{% else %}0{% endif %}{% else %}999{% endif %}"
                      readonly
                      class="cd-qty-input-d5"
                    >
                    <div class="cd-qty-btn-d5 cd-plus-d5 is-loader-d5">
                      <span class="btn-text-d5">
                        <svg viewBox="0 0 20 20">
                          <path d="M10.75 5.75c0-.414-.336-.75-.75-.75s-.75.336-.75.75v3.5h-3.5c-.414 0-.75.336-.75.75s.336.75.75.75h3.5v3.5c0 .414.336.75.75.75s.75-.336.75-.75v-3.5h3.5c.414 0 .75-.336.75-.75s-.336-.75-.75-.75h-3.5v-3.5Z"></path>
                        </svg>
                      </span>
                      <span class="btn-loader-d5"></span>
                    </div>
                  </div>
                  <div class="cd-prices-d5">
                    <p>
                      {% assign var_price = item.variant.compare_at_price | times: item.quantity %}
                      {% if var_price > item.final_line_price %}
                        <span class="cd-compare-price">
                          {{- item.variant.compare_at_price | times: item.quantity | money_without_trailing_zeros -}}
                        </span>
                      {% endif %}
                      <span class="cd-regular-price">
                        {{- item.final_line_price | money_without_trailing_zeros -}}
                      </span>
                      {% if var_price > item.final_line_price %}
                        <span class="cd-save-price"
                          >(Save
                          {{ var_price | minus: item.final_line_price | money_without_trailing_zeros -}}
                          )</span
                        >
                      {% endif %}
                      {% assign discount_amount = item.line_level_discount_allocations | sum: 'amount' %}

                      {% if discount_amount > 0 %}
                        <div class="cd-discounts-d5 cd-item-discounts-d5">
                          <ul>
                            {% for discount in item.discounts %}
                              <li>
                                <svg viewBox="0 0 20 20">
                                  <path d="M13 8a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"></path><path fill-rule="evenodd" d="M11.276 3.5a3.75 3.75 0 0 0-2.701 1.149l-4.254 4.417a2.75 2.75 0 0 0 .036 3.852l2.898 2.898a2.5 2.5 0 0 0 3.502.033l4.747-4.571a3.25 3.25 0 0 0 .996-2.341v-2.187a3.25 3.25 0 0 0-3.25-3.25h-1.974Zm-1.62 2.19a2.25 2.25 0 0 1 1.62-.69h1.974c.966 0 1.75.784 1.75 1.75v2.187c0 .475-.194.93-.536 1.26l-4.747 4.572a1 1 0 0 1-1.401-.014l-2.898-2.898a1.25 1.25 0 0 1-.016-1.75l4.253-4.418Z"></path>
                                </svg>
                                <span>{{ discount.title }}</span>
                              </li>
                            {% endfor %}
                          </ul>
                        </div>
                      {% endif %}
                    </p>
                    {% comment %}
                      {% if item.quantity > 1 %}
                        <p class="cd-total-price-d5">
                          <span class="cd-totalprice-d5">Total Price</span>
                          <span class="total-price-d5-cd">{{ item.original_price | times: item.quantity | money }}</span>
                        </p>
                      {% endif %}
                    {% endcomment %}
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        {% else %}
          <div class="cd-empty-cart-d5">
            <p class="cd-empty-cart-text-d5">Your cart is empty</p>
          </div>
        {% endif %}
      </div>
      <div class="cd-upsells-main-d5">
        <h4>{{ section.settings.up_h | default: 'You may also like' }}</h4>
        <div
          class="cd-up-inner-d5 {% if section.settings.up_type == 'slider' %}up-slider-d5{% else %}up-list-d5{% endif %}"
          id="recommended-products-container"
        >
          {% if section.settings.up_type == 'slider' %}
            <div class="cdup-carousel-btn-d5 up-left-btn-d5"><span></span></div>
            <div class="cdup-carousel-btn-d5 up-right-btn-d5"><span></span></div>
          {% endif %}
          <div class="cd-up-row-d5" id="recommended-products-list">
            {%- comment -%} Products will be loaded dynamically via JavaScript {%- endcomment -%}
            {%- if section.settings.up != blank -%}
              {%- comment -%} Fallback: Show manual upsells initially {%- endcomment -%}
              {% for up in section.settings.up limit: 4 %}
                {% render 'd5-upsell-item', product: up %}
              {% endfor %}
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
    <div class="cd-footer-d5" render-d5>
      {% if cart.item_count > 0 %}
        {% if section.settings.sp != blank %}
          <div class="cd-sp-main-d5">
            <div class="sp-img-d5">
              <img
                src="{{ sp.featured_image | image_url: width: '120' }}"
                alt="Shipping Protection"
                width="50"
                height="50"
                loading="lazy"
              >
            </div>
            <div class="sp-content-d5">
              <h6>
                <span>{{ sp.title }}</span><span>{{ sp.price | money }}</span>
              </h6>
              <p>{{ sp.description | strip_html }}</p>
            </div>
            <div class="sp-toggler-d5">
              <div
                class="sp-t-switch-d5 sp-t-sp-toggle-d5 {% if shipping_protection %}active {% else %}nt-add-d5{% endif %} {% if cart.item_count == 1 and shipping_protection %}nt-remove-d5{% endif %}"
                data-variant="{{ sp.first_available_variant.id }}"
                {% if shipping_protection %}
                  key="{{ sp_key }}"
                {% endif %}
              >
                <div class="sp-t-slider-d5">
                  <div class="sp-t-loader-d5"></div>
                  <div class="sp-t-check-d5">✔</div>
                </div>
              </div>
            </div>
          </div>
        {% endif %}
        {% if cart.total_discount > 0 %}
          <div class="cd-footer-discounts-d5">
            <span class="cd-discounts-d5"
              >Discounts
              <ul>
                {% for discount in cart.discount_applications %}
                  <li>
                    <svg viewBox="0 0 20 20">
                      <path d="M13 8a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"></path><path fill-rule="evenodd" d="M11.276 3.5a3.75 3.75 0 0 0-2.701 1.149l-4.254 4.417a2.75 2.75 0 0 0 .036 3.852l2.898 2.898a2.5 2.5 0 0 0 3.502.033l4.747-4.571a3.25 3.25 0 0 0 .996-2.341v-2.187a3.25 3.25 0 0 0-3.25-3.25h-1.974Zm-1.62 2.19a2.25 2.25 0 0 1 1.62-.69h1.974c.966 0 1.75.784 1.75 1.75v2.187c0 .475-.194.93-.536 1.26l-4.747 4.572a1 1 0 0 1-1.401-.014l-2.898-2.898a1.25 1.25 0 0 1-.016-1.75l4.253-4.418Z"></path>
                    </svg>
                    <span>{{ discount.title }}</span>
                  </li>
                {% endfor %}
              </ul>
            </span>
            <span>- {{ cart.total_discount | money }}</span>
          </div>
        {% endif %}
        {% comment %}
          <div class="cd-footer-total-d5" data-total-price="{{ cart.total_price }}">
            <span>Subtotal</span>
            <span>{{- cart.total_price | money -}}</span>
          </div>
        {% endcomment %}
        <a href="/checkout" class="cd-checkout-btn-d5">
          Checkout&nbsp;&nbsp;•&nbsp;&nbsp;<span class="cd-footer-total-price">
            {{- cart.original_total_price | money -}}
          </span>
        </a>
        {% if section.settings.footer_link_url != blank %}
          <a class="cd-shop-btn-d5" href="{{ section.settings.footer_link_url }}">
            {{- section.settings.footer_link_text | default: 'Or continue shopping' -}}
          </a>
        {% endif %}
        {% if section.settings.p_i != blank %}
          <img
            class="cd-footer-payment-icons-d5"
            src="{{ section.settings.p_i | image_url: width: '600' }}"
            alt="payment Icons"
            width="100%"
            loading="lazy"
            height="100%"
          >
        {% endif %}
      {% else %}
        <div class="cd-empty-footer-d5">
          <p class="cd-empty-announcement-d5">Add your favourite items to your cart.</p>

          <a href="{{ section.settings.empty_cart_page }}" class="cd-checkout-btn-d5"> Shop Now </a>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelector('cart-drawer').remove();
  });
</script>
<a
  hidden
  href="{{ routes.cart_url }}"
  class="header__icon header__icon--cart link focus-inset"
  id="cart-icon-bubble"
  style="display: none !important;"
>
  {%- liquid
    if cart == empty
      render 'icon-cart-empty'
    else
      render 'icon-cart'
    endif
  -%}
  <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
  {%- if cart != empty -%}
    <div class="cart-count-bubble">
      {%- if cart.item_count < 100 -%}
        <span aria-hidden="true">{{ cart.item_count }}</span>
      {%- endif -%}
      <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
    </div>
  {%- endif -%}
</a>
{% schema %}
{
  "name": "D5 Cart Drawer",
  "settings": [
    {
      "type": "header",
      "content": "Empty Cart Drawer"
    },
    {
      "type": "url",
      "id": "empty_cart_page",
      "label": "Empty Cart Drawer Collection URL"
    },
    {
      "type": "header",
      "content": "Cart Footer"
    },
    {
      "type": "text",
      "id": "footer_link_text",
      "label": "Footer Link Text"
    },
    {
      "type": "url",
      "id": "footer_link_url",
      "label": "Footer Link Url"
    },
    {
      "type": "image_picker",
      "id": "p_i",
      "label": "Payment Icons"
    },
    {
      "type": "header",
      "content": "Shipping Protection"
    },
    {
      "type": "product",
      "id": "sp",
      "label": "Shipping Protection"
    },
    {
      "type": "header",
      "content": "Timer"
    },
    {
      "type": "text",
      "id": "timer_text",
      "label": "Timer Text",
      "default": "Your products are reserved for [[time]] minutes!"
    },
    {
      "type": "number",
      "id": "time",
      "label": "Time",
      "default": 15
    },
    {
      "type": "header",
      "content": "Upsells"
    },
    {
      "type": "text",
      "id": "up_h",
      "label": "Upsell Heading",
      "default": "You may also like"
    },
    {
      "type": "product_list",
      "id": "up",
      "label": "Upsell Products"
    },
    {
      "type": "select",
      "id": "up_type",
      "label": "Upsell Type",
      "default": "slider",
      "options": [
        { "label": "Carousel", "value": "slider" },
        { "label": "List", "value": "list" }
      ]
    },
    {
      "type": "header",
      "content": "Milestones Rewards"
    }
  ],

  "presets": [
    {
      "name": "D5 Cart Drawer"
    }
  ]
}
{% endschema %}
{% comment %}
  "blocks": [
     {
       "type": "reward",
       "name": "Reward",
       "settings": [
         {
           "type": "number",
           "id": "mile_stone",
           "label": "Milestone amount",
           "default": 400
         },
         {
           "type": "text",
           "id": "mile_stone_label",
           "label": "Milestone Label",
           "default": "Free Product"
         },
         {
           "type": "image_picker",
           "id": "mile_stone_icon",
           "label": "Milestone Icon"
         }
       ]
     }
   ],
{% endcomment %}
