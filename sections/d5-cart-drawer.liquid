    .cd-remove-icon-d5 {
        flex-grow: 0;
        background: none !important;
    }

    .cd-remove-icon-d5:hover svg path {
        stroke: red;
    }

    .cd-item-info-d5 {
        flex: 1;
    }

    .cd-footer-d5 {
        padding: 23px;
        border-top: 1px solid rgba(0, 0, 0, .1);
        background: #f6f6f7;
        position: sticky;
        bottom: 0;
    }

    .cd-footer-d5 .cd-checkout-btn-d5 {
        height: 50px;
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #277b8e;
        color: #fff;
        font-size: 20px;
        font-weight: 600;
    }

    .cd-footer-d5 .cd-shop-btn-d5{
        font-size: 15px;
        color: #000;
        font-weight: 400;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-top: 8px;
    }

    .cd-footer-d5 .cd-footer-payment-icons-d5{
        height: auto;
        width: 100%;
        margin-top: 15px;
        padding: 0 5px;
    }

    .cd-free-shipping-bar-d5 {
        position: relative;
        background-color: #f0f0f0;
        height: 10px;
        width: 100%;
        margin: 20px 0;
        border-radius: 8px;
    }

    .cd-free-shipping-bar__inner-d5 {
        height: 100%;
        background-color: #27ae60;
        transition: width 0.5s ease-out;
        max-width: 100%;
        display: block !important;
        border-radius: 8px;
        width: 0;
    }

    .cd-free-shipping-bar__content-d5 {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
    }

    .cd-free-shipping-bar__text-d5 {
        font-size: 14px;
        color: #333;
        text-align: center;
        width: 100%;
    }

    .cd-free-shipping-bar__icon-d5 {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        border: 1px solid #27ae60;
        display: flex;
        background: #fff;
        justify-content: center;
        align-items: center;
        position: absolute;
        top: -17px;
        right: 0;
    }
    .cd-free-shipping-bar__icon-d5.rewards-true{
        background-color: #27ae60;
    }
    .cd-free-shipping-bar__icon-d5 .cd-icon-tag-d5 {
        width: 25px;
        height: 25px;
        background-size: 17px !important;
        background-position: center;
        background-repeat: no-repeat;
        background-color: #fff;
        border-radius: 50%;
    }

    .cd-rewards-bar-d5{
        padding: 0 30px 20px;
    }
    .cd-icon-tooltip-d5{
        position: absolute;
        bottom: -18px;
        font-size: 8px;
        text-wrap: nowrap;
        letter-spacing: 0.2px;
    }
    .cd-totalprice-d5{
      display: block;
      font-size: 8px;
      text-wrap: nowrap;
      letter-spacing: 0.2px;
      margin-bottom: -3px;
    }
    .cd-heading-d5 p{
        font-size: 20px;
        font-weight: 600;
    }
    .cd-empty-announcement-d5{
      font-size: 18px;
      font-weight: 600;
      color: #000;
      margin: 0px 0 18px;
      text-align: center;
    }
    .cd-empty-cart-d5{
      display: flex;
      align-items: center;
      justify-content: center;
      height: 100%;
      padding: 20px 16px;

    }
    .cd-empty-cart-text-d5{
      font-size: 22px;
      font-weight: 300;
      color: #111;
    }
    .cd-prices-d5{
      display: flex;
      width: 100%;
      align-items: center;
      justify-content: space-between;
      padding-right: 30px;
    }
    .total-price-d5-cd{
      font-weight: 600;
      color: #000;
    }
    .cd-footer-total-d5{
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 20px;
      color: #000;
      font-weight: 400;
      width: 100%;
      padding: 10px 0;
      line-height: 1;
    }
    .cd-footer-total-d5 span, .cd-footer-discounts-d5 span{
      display: block;
    }
    .cd-footer-discounts-d5{
      display: flex;
      align-items: center;
      justify-content: space-between;
      font-size: 13px;
      color: #000;
      font-weight: 400;
      width: 100%;
      padding: 10px 0 0;
      line-height: 1;
    }
    .cd-footer-discounts-d5 .cd-discounts-d5{
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .cd-discounts-d5 ul{
      display: flex;
      align-items: center;
      gap: 5px;
    }
    .cd-discounts-d5 ul li{
      padding: 2px 4px;
      display: flex;
      align-items: center;
      gap: 5px;
      border-radius: 3px;
      background: rgba(0,0,0,.05);
      color: rgb(88,88,88);
      font-weight: 600;
    }
    .cd-discounts-d5 li svg{
      width: 15px;
      height: 15px;
    }
  .sp-t-switch-d5 {
    position: relative;
    width: 60px;
    height: 30px;
    display: flex;
    align-items: center;
    cursor: pointer;
  }
  .sp-t-slider-d5 {
    position: absolute;
    top: 0; left: 0; right: 0; bottom: 0;
    background: #d0d6dc;
    border-radius: 30px;
    transition: background 0.4s ease;
  }
  .sp-t-slider-d5:before {
    content: "";
    position: absolute;
    height: 22px;
    width: 22px;
    left: 4px;
    bottom: 4px;
    background: #fff;
    border-radius: 50%;
    transition: transform 0.4s ease;
  }
  .sp-t-loader-d5, .sp-t-check-d5 {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    font-size: 14px;
    color: #fff;
    transition: opacity 0.3s ease;
  }
  .sp-t-loader-d5 {
    left: 12px;
    width: 10px;
    height: 10px;
    border: 2px solid rgba(255,255,255,0.6);
    border-top: 2px solid #fff;
    border-radius: 50%;
    opacity: 0;
    display: block !important;
  }
  .sp-t-check-d5 {
    left: 10px;
    opacity: 0;
  }
  .sp-t-switch-d5.active .sp-t-slider-d5 {
    background:rgb(13, 205, 141);
  }
  .sp-t-switch-d5.active .sp-t-slider-d5:before {
    transform: translateX(30px);
  }
  .sp-t-switch-d5.active .sp-t-check-d5 {
    opacity: 1;
  }
  .sp-t-switch-d5.loading .sp-t-loader-d5 {
    opacity: 1;
    animation: sp-t-spin-d5 1s linear infinite;
  }
  .sp-t-switch-d5.loading .sp-t-check-d5 {
    opacity: 0;
  }
  @keyframes sp-t-spin-d5 {
    0% { transform: translateY(-50%) rotate(0deg); }
    100% { transform: translateY(-50%) rotate(360deg); }
  }
  .hidden-line-item-d5, .timer-end-d5{
    display: none !important;
  }
  .cd-sp-main-d5{
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 10px;
  }
  .cd-sp-main-d5 .sp-img-d5{
    min-width: 50px;
    max-width: 50px;
    max-height: 50px;
    background:rgba(221, 221, 221, 0.79);
  }
  .cd-sp-main-d5 .sp-img-d5 img{
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .sp-content-d5 h6{
    margin: 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: #000;
    font-size: 15px;
    font-weight: 600;
  }
  .sp-content-d5 p{
    line-height: normal;
    color: rgba(0,0,0,.5);
    font-size: 13px;
  }
  .cd-timer-main-d5 p{
    opacity: 0;
    transition: all .3s;
    text-align: center;
    font-size: 15px;
    color: #000;
    line-height: normal;
  }
  .cd-timer-main-d5 p span{
    font-weight: 600;
  }
  .cd-timer-main-d5{
    background: rgb(241, 241, 241);
    padding: 10px 0;
    transform: translateY(-15px);
    border-bottom: 1px solid rgb(170, 170, 170);
  }
  .cd-hide-upsell-d5 + .cd-upsells-main-d5{
    display: none !important;
  }
  .cd-upsells-main-d5 h4{
    font-size: 24px;
    color: #000;
    font-weight: 600;
    text-align: center;
    margin-bottom: 12px;
  }
</style>
{% assign sp = section.settings.sp %}
<div class="cart-drawer-d5 cd-drawer__open">
  <div class="cd-overlay-d5" close-cart-d5></div>
  <div class="cd-inner-d5">
    <div class="cd-header-d5">
      <div class="cd-heading-d5" render-d5>
        <p>
          Your Cart&nbsp;•&nbsp;<span class="cd-count-d5"> {{ cart.item_count }}</span>
        </p>
      </div>
      <div class="cd-close-d5" close-cart-d5>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          aria-hidden="true"
          focusable="false"
          class="icon icon-close"
          fill="none"
          viewBox="0 0 18 17"
        >
          <path d="M.865 15.978a.5.5 0 00.707.707l7.433-7.431 7.579 7.282a.501.501 0 00.846-.37.5.5 0 00-.153-.351L9.712 8.546l7.417-7.416a.5.5 0 10-.707-.708L8.991 7.853 1.413.573a.5.5 0 10-.693.72l7.563 7.268-7.418 7.417z" fill="currentColor">
          </path>
        </svg>
      </div>
    </div>
    <div class="cd-content-d5">
      {% if section.settings.timer_text != blank %}
      <div class="cd-timer-main-d5">
        {% assign time = section.settings.time | append: ':00' %}
        {% capture time_content %}
          <span class="cd-timer-time-d5">{{ time }}</span>
        {% endcapture %}
        <p data-time="{{ time }}">{{ section.settings.timer_text | replace: '[[time]]', time_content }}</p>
      </div>
    {% endif %}
      {% comment %}
        {% unless section.settings.milestones == "0" %}
        <div class="cd-rewards-bar-d5">
          {% comment %}
            {% liquid
              assign threshold = section.settings.free_shipping
              assign threshold_in_cents = threshold | times: 100
              assign total = cart.total_price
              assign difference = threshold_in_cents | minus: total
              assign percentage = total | times: 100 | divided_by: threshold_in_cents
            %}
          {% endcomment %}
          {% liquid
            assign total = cart.total_price
            if section.settings.milestones == '1'
              assign mil_1 = section.settings.mile_stone_1 | times: 100
              if total > mil_1
                assign rew_1 = true
              endif
              assign difference = mil_1 | minus: total
              assign percentage = total | times: 100 | divided_by: mil_1
            elsif section.settings.milestones == '2'
              assign mil_1 = section.settings.mile_stone_1 | times: 100
              assign mil_2 = section.settings.mile_stone_2 | times: 100
              assign percentage = total | times: 100 | divided_by: mil_2
              if total > mil_2
                assign rew_2 = true
              elsif total > mil_1
                assign difference = mil_2 | minus: total
                assign rew_1 = true
              elsif mil_1 > total
                assign difference = mil_1 | minus: total
              endif

            elsif section.settings.milestones == '3'
              assign mil_1 = section.settings.mile_stone_1 | times: 100
              assign mil_2 = section.settings.mile_stone_2 | times: 100
              assign mil_3 = section.settings.mile_stone_3 | times: 100
              assign difference = mil_3 | minus: total
              assign percentage = total | times: 100 | divided_by: mil_3
              if total > mil_3
                assign rew_3 = true
              elsif total > mil_2
                assign difference = mil_3 | minus: total
                assign rew_2 = true
              elsif total > mil_1
                assign difference = mil_2 | minus: total
                assign rew_1 = true
              elsif mil_1 > total
                assign difference = mil_1 | minus: total
              endif
            endif
          %}
          <div class="cd-free-shipping-bar__content-d5">
            <p class="cd-free-shipping-bar__text-d5" render-d5>
              {% if section.settings.milestones == '3' %}
                {% if total > mil_3 %}
                  🎉 You've unlocked all rewards!
                {% elsif total > mil_2 %}
                  🎉 {{ section.settings.mile_stone_2_label }} unlocked and <strong>{{ difference | money }}</strong> more
                  for <strong>{{ section.settings.mile_stone_3_label }}</strong>!
                {% elsif total > mil_1 %}
                  🎉 {{ section.settings.mile_stone_1_label }} unlocked and <strong>{{ difference | money }}</strong> more
                  for <strong>{{ section.settings.mile_stone_2_label }}</strong>!
                {% elsif mil_1 > total %}
                  You are <strong>{{ difference | money }}</strong> away from {{ section.settings.mile_stone_1_label }}!
                {% endif %}
              {% elsif section.settings.milestones == '2' %}
                {% if total > mil_2 %}
                  🎉 You've unlocked all rewards!
                {% elsif total > mil_1 %}
                  🎉 {{ section.settings.mile_stone_1_label }} unlocked and <strong>{{ difference | money }}</strong> more
                  for <strong>{{ section.settings.mile_stone_2_label }}</strong>!
                {% elsif mil_1 > total %}
                  You are <strong>{{ difference | money }}</strong> away from
                  <strong>{{ section.settings.mile_stone_1_label }}</strong>!
                {% endif %}
              {% elsif section.settings.milestones == '1' %}
                {% if total > mil_1 %}
                  🎉 You've unlocked <strong>{{ section.settings.mile_stone_1_label }}</strong>!
                {% elsif mil_1 > total %}
                  You are <strong>{{ difference | money }}</strong> away from {{ section.settings.mile_stone_1_label }}!
                {% endif %}
              {% endif %}
            </p>
          </div>
          <div class="cd-free-shipping-bar-d5">
            <div
              class="cd-free-shipping-bar__inner-d5"
              style="width: {{ percentage | round: 2 }}%;"
            ></div>
            <div render-d5>
              {% if section.settings.milestones == '1' %}
                <div
                  class="cd-free-shipping-bar__icon-d5 {% if rew_1 %}rewards-true{% else %} rewards-false{% endif %}"
                  style="right: 0"
                >
                  <span
                    class="cd-icon-tag-d5"
                    style="background-image: url('{{ section.settings.mile_stone_1_icon | image_url: width: '50px' }}')"
                  ></span>
                  <span class="cd-icon-tooltip-d5">{{ section.settings.mile_stone_1_label }}</span>
                </div>
              {% elsif section.settings.milestones == '2' %}
                <div
                  class="cd-free-shipping-bar__icon-d5 {% if rew_2 %}rewards-true{% else %} rewards-false{% endif %}"
                  style="right: 0%"
                >
                  <span
                    class="cd-icon-tag-d5"
                    style="background-image: url('{{ section.settings.mile_stone_2_icon | image_url: width: '50px' }}')"
                  ></span>
                  <span class="cd-icon-tooltip-d5">{{ section.settings.mile_stone_2_label }}</span>
                </div>
                <div
                  class="cd-free-shipping-bar__icon-d5 {% if rew_1 or rew_2 %}rewards-true{% else %} rewards-false{% endif %}"
                  style="right: 50%"
                >
                  <span
                    class="cd-icon-tag-d5"
                    style="background-image: url('{{ section.settings.mile_stone_1_icon | image_url: width: '50px' }}')"
                  ></span>
                  <span class="cd-icon-tooltip-d5">{{ section.settings.mile_stone_1_label }}</span>
                </div>
              {% elsif section.settings.milestones == '3' %}
                <div
                  class="cd-free-shipping-bar__icon-d5 {% if rew_3 %}rewards-true{% else %} rewards-false{% endif %}"
                  style="right: 0"
                >
                  <span
                    class="cd-icon-tag-d5"
                    style="background-image: url('{{ section.settings.mile_stone_3_icon | image_url: width: '50px' }}')"
                  ></span>
                  <span class="cd-icon-tooltip-d5">{{ section.settings.mile_stone_3_label }}</span>
                </div>
                <div
                  class="cd-free-shipping-bar__icon-d5 {% if rew_3 or rew_2 %}rewards-true{% else %} rewards-false{% endif %}"
                  style="right: 33%"
                >
                  <span
                    class="cd-icon-tag-d5"
                    style="background-image: url('{{ section.settings.mile_stone_2_icon | image_url: width: '50px' }}')"
                  ></span>
                  <span class="cd-icon-tooltip-d5">{{ section.settings.mile_stone_2_label }}</span>
                </div>
                <div
                  class="cd-free-shipping-bar__icon-d5 {% if rew_1 or rew_2 or rew_3 %}rewards-true{% else %} rewards-false{% endif %}"
                  style="right: 66%"
                >
                  <span
                    class="cd-icon-tag-d5"
                    style="background-image: url('{{ section.settings.mile_stone_1_icon | image_url: width: '50px' }}')"
                  ></span>
                  <span class="cd-icon-tooltip-d5">{{ section.settings.mile_stone_1_label }}</span>
                </div>
              {% endif %}
            </div>
          </div>
        </div>
        {% endunless %}
      {% endcomment %}
      <div class="cd-rewards-bar-d5">
        {% liquid
          assign total = cart.total_price
          assign milestones_count = section.blocks.size
          assign highest_milestone = 0
          assign current_milestone_index = -1
          assign next_milestone = 0
          assign difference = 0
          assign percentage = 0

          for block in section.blocks
            assign milestone_amount = block.settings.mile_stone | times: 100
            if milestone_amount > highest_milestone
              assign highest_milestone = milestone_amount
            endif
          endfor

          assign sorted_blocks = section.blocks | sort: 'settings.mile_stone'

          for block in sorted_blocks
            assign milestone_amount = block.settings.mile_stone | times: 100
            if total >= milestone_amount
              assign current_milestone_index = forloop.index0
              assign current_milestone_amount = milestone_amount
              assign current_milestone_label = block.settings.mile_stone_label
            endif
          endfor

          assign next_milestone_index = current_milestone_index | plus: 1
          if next_milestone_index < milestones_count
            assign next_block = sorted_blocks[next_milestone_index]
            assign next_milestone = next_block.settings.mile_stone | times: 100
            assign next_milestone_label = next_block.settings.mile_stone_label
            assign difference = next_milestone | minus: total
          else
            if current_milestone_index >= 0
              assign next_milestone = highest_milestone
              assign next_milestone_label = sorted_blocks[current_milestone_index].settings.mile_stone_label
            else
              assign next_milestone = sorted_blocks[0].settings.mile_stone | times: 100
              assign next_milestone_label = sorted_blocks[0].settings.mile_stone_label
            endif
            assign difference = 0
          endif

          if current_milestone_index == -1 and milestones_count > 0
            assign next_milestone = sorted_blocks[0].settings.mile_stone | times: 100
            assign next_milestone_label = sorted_blocks[0].settings.mile_stone_label
            assign difference = next_milestone | minus: total
          endif

          if highest_milestone > 0
            assign percentage = total | times: 100 | divided_by: highest_milestone
            if percentage > 100
              assign percentage = 100
            endif
          endif
        %}

        <div class="cd-free-shipping-bar__content-d5">
          <p class="cd-free-shipping-bar__text-d5" render-d5>
            {% if total >= highest_milestone and milestones_count > 0 %}
              🎉 You've unlocked all rewards!
            {% elsif current_milestone_index >= 0 and next_milestone_index < milestones_count %}
              🎉 {{ current_milestone_label }} unlocked and <strong>{{ difference | money }}</strong> more for
              <strong>{{ next_milestone_label }}</strong>!
            {% elsif current_milestone_index >= 0 %}
              🎉 You've unlocked <strong>{{ current_milestone_label }}</strong>!
            {% else %}
              You are <strong>{{ difference | money }}</strong> away from <strong>{{ next_milestone_label }}</strong>!
            {% endif %}
          </p>
        </div>

        <div class="cd-free-shipping-bar-d5">
          <div
            class="cd-free-shipping-bar__inner-d5"
            style="width: {{ percentage }}%;"
          ></div>
          <div render-d5>
            {% for block in sorted_blocks reversed %}
              {% assign position = 0 %}
              {% if milestones_count > 1 %}
                {% assign segment = 100 | divided_by: milestones_count | minus: 1 %}
                {% assign position = segment | times: forloop.index0 %}
              {% endif %}

              {% assign milestone_amount = block.settings.mile_stone | times: 100 %}
              <div
                class="cd-free-shipping-bar__icon-d5 {% if total >= milestone_amount %}rewards-true{% else %}rewards-false{% endif %}"
                style="right: {{ position }}%"
              >
                <span
                  class="cd-icon-tag-d5"
                  style="background-image: url('{{ block.settings.mile_stone_icon | image_url: width: '50px' }}')"
                ></span>
                <span class="cd-icon-tooltip-d5">{{ block.settings.mile_stone_label }}</span>
              </div>
            {% endfor %}
          </div>
        </div>
      </div>
      <div class="atc-loader-d5">
        <span class="item-loader-d5"></span>
      </div>
      <div class="cd-cart-items-d5 {% if cart.item_count == 0 %}cd-hide-upsell-d5{% endif %}" render-d5 data-width="{{ percentage | round: 2 }}%" shipping-bar-d5>
        {% if cart.item_count > 0 %}
          {% for item in cart.items %}
            {% if item.product_id == sp.id %}
              {% assign shipping_protection = true %}
              {% assign sp_key = item.key %}
            {% endif %}
            <div
              class="cd-item-d5 real-item-d5 {% if item.product_id == sp.id %}hidden-line-item-d5{% endif %}"
              data-variant-id="{{ item.variant.id }}"
              data-line-item-key="{{ item.key }}"
            >
              <span class="item-loader-d5"></span>
              <div class="item-light-overlay-d5"></div>
              <div class="cd-item-img-d5" style="--aspect-ratio: {{ item.image.aspect_ratio }}">
                <a href="{{ item.url }}">
                  <img
                    src="{{ item.image |  image_url: width: 400 }}"
                    width="130"
                    height="{{ item.image.height }}"
                    alt="{{ item.title }}"
                    loading="lazy"
                  >
                </a>
              </div>
              <div class="cd-item-info-d5">
                <div class="cd-title-price-d5">
                  <h4>
                    <a href="{{ item.product.url }}">{{ item.product.title }}</a>
                    <div class="cd-remove-d5 cd-qty-btn-d5 cd-remove-icon-d5">
                      {% render 'd5-delete-icon' %}
                    </div>
                  </h4>
                  <div class="cd-prices-d5">
                    <p>
                      <span class="cd-regular-price">{{ item.original_price | money }}</span>
                      <span class="cd-compare-price">{{ item.product.final_price | money }}</span>
                    </p>
                    {% if item.quantity > 1 %}
                      <p class="cd-total-price-d5">
                        <span class="cd-totalprice-d5">Total Price</span>
                        <span class="total-price-d5-cd">{{ item.original_price | times: item.quantity | money }}</span>
                      </p>
                    {% endif %}
                  </div>
                </div>
                {%- if item.product.has_only_default_variant == false
                  or item.properties.size != 0
                  or item.selling_plan_allocation != null
                -%}
                  <div class="cd-item-variants-d5">
                    {% if item.product.has_only_default_variant == false %}
                      {% for option in item.options_with_values %}
                        <div class="cd-otpions-d5">
                          <h5>{{ option.name }}:</h5>
                          <p>{{ option.value }}</p>
                        </div>
                      {% endfor %}
                    {% endif %}
                  </div>
                {% endif %}
                <div class="cd-quantity-d5">
                  {% assign qty = item.variant.inventory_management %}
                  <div class="cd-qty-btn-d5 is-loader-d5 {% if item.quantity == 1 %}cd-remove-d5{% else %}cd-minus-d5{% endif %}">
                    <span class="btn-text-d5">
                      <svg viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M5 10c0-.414.336-.75.75-.75h8.5c.414 0 .75.336.75.75s-.336.75-.75.75h-8.5c-.414 0-.75-.336-.75-.75Z"></path>
                      </svg>
                    </span>
                    <span class="btn-loader-d5"></span>
                  </div>
                  <input
                    type="text"
                    value="{{ item.quantity }}"
                    data-max="{% if qty %}{%if item.variant.inventory_quantity > 1 %}{{ item.variant.inventory_quantity }}{% else %}0{% endif %}{% else %}999{% endif %}"
                    readonly
                    class="cd-qty-input-d5"
                  >
                  <div class="cd-qty-btn-d5 cd-plus-d5 is-loader-d5">
                    <span class="btn-text-d5">
                      <svg viewBox="0 0 20 20">
                        <path d="M10.75 5.75c0-.414-.336-.75-.75-.75s-.75.336-.75.75v3.5h-3.5c-.414 0-.75.336-.75.75s.336.75.75.75h3.5v3.5c0 .414.336.75.75.75s.75-.336.75-.75v-3.5h3.5c.414 0 .75-.336.75-.75s-.336-.75-.75-.75h-3.5v-3.5Z"></path>
                      </svg>
                    </span>
                    <span class="btn-loader-d5"></span>
                  </div>
                </div>
              </div>
            </div>
          {% endfor %}
        {% else %}
          <div class="cd-empty-cart-d5">
            <p class="cd-empty-cart-text-d5">Your cart is empty</p>
          </div>
        {% endif %}
      </div>
      {% if section.settings.up != blank %}
      <div class="cd-upsells-main-d5">
        <h4>{{ section.settings.up_h }}</h4>
        <div class="cd-up-inner-d5">
          <div class="cd-up-row-d5">
            {% for up in section.settings.up %}
              {% unless up.variants.size == 1 and up.first_available_variant.available  %}
                
              
              <div class="cd-up-item-d5">
                <div class="cd-up-img-d5">
                  <img class="up-img-d5" src="{{ up.featured_image | image_url: width: 200 }}" width="80" height="80" alt="{{ up.title }}" loading="lazy">
                </div>
                <div class="cd-up-item-content-d5">
                  <h5>{{ up.title }}</h5>
                  <div class="cd-up-price-d5">
                    <span class="cd-up-comp-price-d5">{{ up.compare_at_price | money }}</span>
                    <span class="cd-up-reg-price-d5">{{ up.price | money }}</span>
                  </div>
                  <form class="cd-up-form-d5" action="{{ routes.cart_add_url }}" method="POST">
                    <input type="hidden" value="1" name="quantity">
                    {% if up.variants.size > 1 %}
                    <select name="id" class="cd-up-variant-select-d5">
                      {% for variant in up.variants %}
                        <option value="{{ variant.id }}" {% unless variant.available %}disabled{% endunless %} data-regular="{{ variant.price | money }}" data-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}" {% if variant.featured_image %}data-img="{{ variant.featured_image | image_url: width: 200 }}"{% endif %}>{{ variant.title }}</option>
                      {% endfor %}
                    </select>
                  {% else %}
                    <input type="hidden" value="{{ up.first_available_variant.id }}" name="id">
                  {% endif %}
                    <button name="add" type="submit">Add</button>
                  </form>
                </div>
              </div>
              {% endunless %}
            {% endfor %}
          </div>
        </div>
      </div>
    {% endif %}
    </div>
    <div class="cd-footer-d5" render-d5>
      {% if cart.item_count > 0 %}
        {% if section.settings.sp != blank %}
          <div class="cd-sp-main-d5">
            <div class="sp-img-d5">
              <img
                src="{{ sp.featured_image | image_url: width: '120' }}"
                alt="Shipping Protection"
                width="50"
                height="50"
                loading="lazy"
              >
            </div>
            <div class="sp-content-d5">
              <h6>
                <span>{{ sp.title }}</span><span>{{ sp.price | money }}</span>
              </h6>
              <p>{{ sp.description | strip_html }}</p>
            </div>
            <div class="sp-toggler-d5">
              <div
                class="sp-t-switch-d5 sp-t-sp-toggle-d5 {% if shipping_protection %}active {% else %}nt-add-d5{% endif %} {% if cart.item_count == 1 and shipping_protection %}nt-remove-d5{% endif %}"
                data-variant="{{ sp.first_available_variant.id }}"
                {% if shipping_protection %}
                  key="{{ sp_key }}"
                {% endif %}
              >
                <div class="sp-t-slider-d5">
                  <div class="sp-t-loader-d5"></div>
                  <div class="sp-t-check-d5">✔</div>
                </div>
              </div>
            </div>
          </div>
        {% endif %}
        {% if cart.total_discount > 0 %}
          <div class="cd-footer-discounts-d5">
            <span class="cd-discounts-d5"
              >Discounts
              <ul>
                {% for discount in cart.discount_applications %}
                  <li>
                    <svg viewBox="0 0 20 20">
                      <path d="M13 8a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z"></path><path fill-rule="evenodd" d="M11.276 3.5a3.75 3.75 0 0 0-2.701 1.149l-4.254 4.417a2.75 2.75 0 0 0 .036 3.852l2.898 2.898a2.5 2.5 0 0 0 3.502.033l4.747-4.571a3.25 3.25 0 0 0 .996-2.341v-2.187a3.25 3.25 0 0 0-3.25-3.25h-1.974Zm-1.62 2.19a2.25 2.25 0 0 1 1.62-.69h1.974c.966 0 1.75.784 1.75 1.75v2.187c0 .475-.194.93-.536 1.26l-4.747 4.572a1 1 0 0 1-1.401-.014l-2.898-2.898a1.25 1.25 0 0 1-.016-1.75l4.253-4.418Z"></path>
                    </svg>
                    <span>{{ discount.title }}</span>
                  </li>
                {% endfor %}
              </ul>
            </span>
            <span>- {{ cart.total_discount | money }}</span>
          </div>
        {% endif %}
        <div class="cd-footer-total-d5">
          <span>Subtotal</span>
          <span>{{- cart.original_total_price | money -}}</span>
        </div>
        <a href="/checkout" class="cd-checkout-btn-d5"
          >Proceed To Checkout
          {% comment %}
            Checkout&nbsp;&nbsp;•&nbsp;&nbsp;<span class="cd-footer-total-price">
              {{- cart.original_total_price | money -}}
            </span>
          {% endcomment %}
        </a>
        {% if section.settings.footer_link_url != blank %}
          <a class="cd-shop-btn-d5" href="{{ section.settings.footer_link_url }}">
            {{- section.settings.footer_link_text | default: 'Or continue shopping' -}}
          </a>
        {% endif %}
        {% if section.settings.p_i != blank %}
          <img
            class="cd-footer-payment-icons-d5"
            src="{{ section.settings.p_i | image_url: width: '600' }}"
            alt="payment Icons"
            width="100%"
            loading="lazy"
            height="100%"
          >
        {% endif %}
      {% else %}
        <div class="cd-empty-footer-d5">
          <p class="cd-empty-announcement-d5">Add your favourite items to your cart.</p>

          <a href="{{ section.settings.empty_cart_page }}" class="cd-checkout-btn-d5"> Shop Now </a>
        </div>
      {% endif %}
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    document.querySelector('cart-drawer').remove();
  });
</script>
<a
  hidden
  href="{{ routes.cart_url }}"
  class="header__icon header__icon--cart link focus-inset"
  id="cart-icon-bubble"
  style="display: none !important;"
>
  {%- liquid
    if cart == empty
      render 'icon-cart-empty'
    else
      render 'icon-cart'
    endif
  -%}
  <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
  {%- if cart != empty -%}
    <div class="cart-count-bubble">
      {%- if cart.item_count < 100 -%}
        <span aria-hidden="true">{{ cart.item_count }}</span>
      {%- endif -%}
      <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
    </div>
  {%- endif -%}
</a>
{% schema %}
{
  "name": "D5 Cart Drawer",
  "settings": [
    {
      "type": "header",
      "content": "Empty Cart Drawer"
    },
    {
      "type": "url",
      "id": "empty_cart_page",
      "label": "Empty Cart Drawer Collection URL"
    },
    {
      "type": "header",
      "content": "Cart Footer"
    },
    {
      "type": "text",
      "id": "footer_link_text",
      "label": "Footer Link Text"
    },
    {
      "type": "url",
      "id": "footer_link_url",
      "label": "Footer Link Url"
    },
    {
      "type": "image_picker",
      "id": "p_i",
      "label": "Payment Icons"
    },
    {
      "type": "header",
      "content": "Shipping Protection"
    },
    {
      "type": "product",
      "id": "sp",
      "label": "Shipping Protection"
    },
    {
      "type": "header",
      "content": "Timer"
    },
    {
      "type": "text",
      "id": "timer_text",
      "label": "Timer Text",
      "default": "Your products are reserved for [[time]] minutes!"
    },
    {
      "type": "number",
      "id": "time",
      "label": "Time",
      "default": 15
    },
    {
      "type": "header",
      "content": "Upsells",
    },
    {
      "type": "text",
      "id": "up_h",
      "label": "Upsell Heading",
      "default": "You may also like"
    },
    {
      "type": "product_list",
      "id": "up",
      "label": "Upsell Products"
    }
  ],
  "blocks": [
    {
      "type": "reward",
      "name": "Reward",
      "settings": [
        {
          "type": "number",
          "id": "mile_stone",
          "label": "Milestone amount",
          "default": 400
        },
        {
          "type": "text",
          "id": "mile_stone_label",
          "label": "Milestone Label",
          "default": "Free Product"
        },
        {
          "type": "image_picker",
          "id": "mile_stone_icon",
          "label": "Milestone Icon"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "D5 Cart Drawer"
    }
  ]
}
{% endschema %}
