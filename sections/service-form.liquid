      "default": "Photos & videos"
    },
    {
      "type": "text",
      "id": "s3_photos_upload",
      "label": "Upload button text",
      "default": "Click to upload photos & videos"
    },
    {
      "type": "text",
      "id": "s3_photos_hint",
      "label": "Upload hint",
      "default": "Images and videos — multiple files allowed"
    },
    {
      "type": "text",
      "id": "s3_photos_note",
      "label": "Upload note",
      "default": "Files upload automatically when you submit. Images & videos supported."
    },
    {
      "type": "text",
      "id": "s3_drive_label",
      "label": "Cloud link label",
