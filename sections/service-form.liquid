      "default": "You must accept the terms before submitting."
    },
    {
      "type": "header",
      "content": "Category 1"
    },
    {
      "type": "inline_richtext",
      "id": "ch_1",
      "label": "Heading",
      "default": "Electric Screen"
    },
    {
      "type": "text",
      "id": "ce_1",
      "label": "Emoji / Icon text",
      "default": "⚡"
    },
    {
      "type": "image_picker",
      "id": "ci_1",
      "label": "Icon image (overrides emoji)"
    },
    { "type": "text", "id": "c1_v1", "label": "Model 1", "default": "Saker" },
    { "type": "text", "id": "c1_v2", "label": "Model 2", "default": "Saker Tab-Tension" },
    { "type": "text", "id": "c1_v3", "label": "Model 3", "default": "Evanesce" },
