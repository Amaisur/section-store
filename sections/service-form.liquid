<style>
    .srf__section { padding: 4rem 0; }

.srf__container {
  max-width: 860px;
  margin: 0 auto;
}

.srf__heading {
  font-size: 2rem;
  font-weight: 700;
  text-align: center;
  margin: 0 0 0.5rem;
}

.srf__subheading {
  text-align: center;
  opacity: 0.65;
  font-size: 14px;
  margin: 0 0 2.5rem;
}

/* ── Progress ── */
.srf__progress {
  display: flex;
  justify-content: center;
  align-items: flex-start;
  position: relative;
  margin-bottom: 3rem;
}

.srf__progress::before {
  content: '';
  position: absolute;
  top: 19px;
  left: 50%;
  transform: translateX(-50%);
  width: 320px;
  height: 2px;
  background: #e5e5e5;
  z-index: 0;
}

.srf__progress-fill {
  position: absolute;
  top: 19px;
  left: 50%;
  transform: translateX(-50%) translateX(-160px);
  height: 2px;
  width: 0;
  background: rgba(var(--color-button), var(--alpha-button-background));
  transition: width 0.4s ease;
  z-index: 1;
}

.srf__progress-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  width: 160px;
  position: relative;
  z-index: 2;
}

.srf__step-circle {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  border: 2px solid #e5e5e5;
  background: rgb(var(--color-background));
  display: flex;
  align-items: center;
  justify-content: center;
  font-weight: 700;
  font-size: 15px;
  color: #aaa;
  transition: all 0.3s;
}

.srf__step-label {
  font-size: 11px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  color: #aaa;
  transition: color 0.3s;
}

.srf__progress-step.is-active .srf__step-circle {
  border-color: rgba(var(--color-button), var(--alpha-button-background));
  background: rgba(var(--color-button), var(--alpha-button-background));
  color: rgb(var(--color-button-text));
}

.srf__progress-step.is-active .srf__step-label { color: rgba(var(--color-button), var(--alpha-button-background)); }

.srf__progress-step.is-done .srf__step-circle {
  border-color: rgba(var(--color-button), var(--alpha-button-background));
  background: rgba(var(--color-button), var(--alpha-button-background));
  color: rgb(var(--color-button-text));
}

.srf__progress-step.is-done .srf__step-label { color: rgba(var(--color-button), var(--alpha-button-background)); }

/* ── Stage panels ── */
.srf__stage { display: none; }
.srf__stage.is-active { display: block; }

.srf__stage-title {
  font-size: 1.35rem;
  font-weight: 700;
  margin: 0 0 0.4rem;
}

.srf__stage-desc {
  font-size: 13px;
  opacity: 0.6;
  margin: 0 0 2rem;
}

/* ── Category cards ── */
.srf__category-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(175px, 1fr));
  gap: 12px;
  margin-bottom: 2rem;
}

.srf__category-card input[type='radio'] { display: none; }

.srf__category-card label {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10px;
  padding: 1.25rem 1rem;
  border: 2px solid #e5e5e5;
  border-radius: 12px;
  cursor: pointer;
  font-weight: 600;
  font-size: 13px;
  text-align: center;
  transition: border-color 0.2s, background 0.2s;
  line-height: 1.3;
}

.srf__category-card label:hover { border-color: rgba(var(--color-button), 0.5); }

.srf__category-card input:checked + label {
  border-color: rgba(var(--color-button), var(--alpha-button-background));
  background: rgba(var(--color-button), 0.06);
}

.srf__cat-icon { font-size: 1.8rem; }

/* ── Fields ── */
.srf__field { margin-bottom: 1.25rem; }

.srf__label {
  display: block;
  font-weight: 600;
  font-size: 13px;
  margin-bottom: 5px;
}

.srf__required { color: #e00; margin-left: 2px; }

.srf__select-wrap { position: relative; }

.srf__select-wrap::after {
  content: '';
  position: absolute;
  right: 14px;
  top: 50%;
  transform: translateY(-50%);
  border: 5px solid transparent;
  border-top-color: #666;
  pointer-events: none;
}

.srf__select,
.srf__input,
.srf__textarea {
  width: 100%;
  padding: 11px 14px;
  border: 1.5px solid #e5e5e5;
  border-radius: 8px;
  font-size: 14px;
  font-family: inherit;
  background: rgb(var(--color-background));
  color: rgb(var(--color-foreground));
  transition: border-color 0.2s;
  appearance: none;
}

.srf__select:focus,
.srf__input:focus,
.srf__textarea:focus {
  outline: none;
  border-color: rgba(var(--color-button), var(--alpha-button-background));
}

.srf__textarea { min-height: 110px; resize: vertical; }

.srf__select.has-error,
.srf__input.has-error,
.srf__textarea.has-error { border-color: #e00; }

.srf__field-error {
  display: none;
  font-size: 12px;
  color: #e00;
  margin-top: 4px;
}

/* ── Problem groups ── */
.srf__problem-groups { margin-bottom: 2rem; }

.srf__problem-group {
  border: 1.5px solid #e5e5e5;
  border-radius: 10px;
  margin-bottom: 10px;
  overflow: hidden;
}

.srf__group-toggle {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 13px 16px;
  cursor: pointer;
  font-weight: 600;
  font-size: 13px;
  background: #f7f7f7;
  user-select: none;
  gap: 8px;
}

.srf__group-toggle svg {
  width: 14px;
  height: 14px;
  flex-shrink: 0;
  transition: transform 0.25s;
}

.srf__problem-group.is-open .srf__group-toggle svg { transform: rotate(180deg); }

.srf__group-body {
  display: none;
  padding: 12px 16px;
  display: none;
  grid-template-columns: 1fr 1fr;
  gap: 8px 16px;
}

.srf__problem-group.is-open .srf__group-body { display: grid; }

.srf__check-item {
  display: flex;
  align-items: flex-start;
  gap: 8px;
  cursor: pointer;
  font-size: 13px;
  line-height: 1.4;
}

.srf__check-item input[type='checkbox'] {
  width: 15px;
  height: 15px;
  margin-top: 1px;
  flex-shrink: 0;
  cursor: pointer;
  accent-color: rgba(var(--color-button), var(--alpha-button-background));
}

.srf__problems-error {
  display: none;
  font-size: 12px;
  color: #e00;
  margin-bottom: 8px;
}

/* ── Info grid ── */
.srf__info-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0 1.5rem;
}

.srf__field.col-full { grid-column: 1 / -1; }

/* ── File upload ── */
.srf__file-drop {
  border: 2px dashed #e5e5e5;
  border-radius: 8px;
  padding: 1.5rem;
  text-align: center;
  cursor: pointer;
  transition: border-color 0.2s;
  position: relative;
}

.srf__file-drop:hover { border-color: rgba(var(--color-button), 0.5); }

.srf__file-drop input[type='file'] {
  position: absolute;
  inset: 0;
  opacity: 0;
  cursor: pointer;
  width: 100%;
  height: 100%;
}

.srf__file-drop-text { font-size: 13px; color: #888; pointer-events: none; }
.srf__file-drop-text strong { display: block; color: rgb(var(--color-foreground)); margin-bottom: 4px; }
.srf__file-names { font-size: 12px; margin-top: 6px; color: rgba(var(--color-button), var(--alpha-button-background)); }

/* ── Stage error banner ── */
.srf__stage-error {
  display: none;
  background: #fff3f3;
  border: 1px solid #ffcdd2;
  color: #b71c1c;
  padding: 10px 14px;
  border-radius: 8px;
  font-size: 13px;
  margin-bottom: 1rem;
}

/* ── Buttons ── */
.srf__buttons {
  display: flex;
  gap: 12px;
  justify-content: flex-end;
  margin-top: 2rem;
  padding-top: 1.5rem;
  border-top: 1px solid #e5e5e5;
}

.srf__btn {
  padding: 11px 28px;
  border-radius: 8px;
  font-size: 14px;
  font-weight: 600;
  cursor: pointer;
  transition: opacity 0.2s, background 0.2s;
  font-family: inherit;
  border: none;
}

.srf__btn--primary {
  background: rgba(var(--color-button), var(--alpha-button-background));
  color: rgb(var(--color-button-text));
}

.srf__btn--primary:hover { opacity: 0.82; }

.srf__btn--secondary {
  background: transparent;
  border: 1.5px solid #ddd;
  color: rgb(var(--color-foreground));
}

.srf__btn--secondary:hover { border-color: #999; }

/* ── Confirmation ── */
.srf__confirmation {
  text-align: center;
  padding: 4rem 2rem;
}

.srf__confirm-icon { font-size: 3.5rem; margin-bottom: 1rem; }
.srf__confirmation h2 { font-size: 1.5rem; font-weight: 700; margin: 0 0 1rem; }
.srf__confirmation p { max-width: 520px; margin: 0 auto; line-height: 1.7; opacity: 0.7; font-size: 14px; }

/* ── Mobile ── */
@media (max-width: 749px) {
  .srf__progress::before { width: 200px; }
  .srf__progress-fill { transform: translateX(-50%) translateX(-100px); }
  .srf__progress-step { width: 100px; }
  .srf__category-grid { grid-template-columns: repeat(2, 1fr); }
  .srf__group-body { grid-template-columns: 1fr; }
  .srf__info-grid { grid-template-columns: 1fr; }
  .srf__buttons { flex-direction: column-reverse; }
  .srf__btn { width: 100%; text-align: center; }
  .srf__section { padding: 2rem 0; }
}

</style>

{{ 'cs-service-form.css' | asset_url | stylesheet_tag }}

<section
  id="srf--{{ section.id }}"
  class="srf__section color-{{ section.settings.color_scheme }} gradient"
>
  <div class="page-width">
    <div class="srf__container">

      {% form 'contact' %}

        {% if form.posted_successfully? %}

          <div class="srf__confirmation">
            <div class="srf__confirm-icon">✅</div>
            <h2>{{ section.settings.confirm_title | default: 'Request Received' }}</h2>
            <p>{{ section.settings.confirm_message | default: 'Thank you. Your service request has been received. Our support team will review your case and contact you as soon as possible. Please note that incomplete or unclear information may delay processing.' }}</p>
          </div>

        {% else %}

          {% if section.settings.heading != blank %}
            <h1 class="srf__heading">{{ section.settings.heading }}</h1>
          {% endif %}
          {% if section.settings.subheading != blank %}
            <p class="srf__subheading">{{ section.settings.subheading }}</p>
          {% endif %}

          <!-- Hidden compiled fields sent to Shopify contact form -->
          <input type="hidden" name="contact[subject]" id="srf_subject">
          <input type="hidden" name="contact[body]" id="srf_body">
          <input type="hidden" name="contact[email]" id="srf_email_hidden">
          <input type="hidden" name="contact[name]" id="srf_name_hidden">

          <!-- Progress bar -->
          <div class="srf__progress" aria-label="Form progress">
            <div class="srf__progress-fill" id="srf_progress_fill"></div>
            <div class="srf__progress-step is-active" data-step="1">
              <div class="srf__step-circle">1</div>
              <div class="srf__step-label">{{ section.settings.step_1_label | default: 'Product' }}</div>
            </div>
            <div class="srf__progress-step" data-step="2">
              <div class="srf__step-circle">2</div>
              <div class="srf__step-label">{{ section.settings.step_2_label | default: 'Problem' }}</div>
            </div>
            <div class="srf__progress-step" data-step="3">
              <div class="srf__step-circle">3</div>
              <div class="srf__step-label">{{ section.settings.step_3_label | default: 'Details' }}</div>
            </div>
          </div>

          <!-- ══════════════════════════════════════════
               STAGE 1 — Product Selection
          ══════════════════════════════════════════ -->
          <div class="srf__stage is-active" data-stage="1">
            <h2 class="srf__stage-title">{{ section.settings.s1_title | default: 'Select Your Product' }}</h2>
            <p class="srf__stage-desc">{{ section.settings.s1_desc | default: 'Choose the product category and model that your request is about.' }}</p>

            <div class="srf__stage-error" id="srf_error_1">{{ section.settings.s1_error_cat | default: 'Please select a product category before continuing.' }}</div>

            <p class="srf__label">{{ section.settings.s1_cat_label | default: 'Product category' }} <span class="srf__required">*</span></p>
            <div class="srf__category-grid" id="srf_category_grid">
              {% for i in (1..10) %}
                {% assign ch_key = 'ch_' | append: i %}
                {% assign cat_name = section.settings[ch_key] | strip_html | strip %}
                {% if cat_name != blank %}
                  {% if i == 1 %}
                    {% assign model_prefix = 'c1_v' %}
                  {% else %}
                    {% assign model_prefix = 'v' | append: i | append: '_' %}
                  {% endif %}
                  {% assign models_list = '' %}
                  {% for j in (1..10) %}
                    {% assign model_key = model_prefix | append: j %}
                    {% assign model_val = section.settings[model_key] %}
                    {% if model_val != blank %}
                      {% unless models_list == '' %}{% assign models_list = models_list | append: '|' %}{% endunless %}
                      {% assign models_list = models_list | append: model_val %}
                    {% endif %}
                  {% endfor %}
                  {% assign ce_key = 'ce_' | append: i %}
                  {% assign ci_key = 'ci_' | append: i %}
                  {% assign cat_emoji = section.settings[ce_key] %}
                  {% assign cat_image = section.settings[ci_key] %}
                  {% assign cat_id = 'cat_' | append: i %}
                  <div class="srf__category-card">
                    <input type="radio" name="srf_category" id="{{ cat_id }}" value="{{ cat_name | escape }}" data-models="{{ models_list | escape }}">
                    <label for="{{ cat_id }}">
                      {% if cat_image %}
                        <span class="srf__cat-icon"><img src="{{ cat_image | image_url: width: 40 }}" alt="{{ cat_name }}" width="24" height="24" loading="lazy"></span>
                      {% elsif cat_emoji != blank %}
                        <span class="srf__cat-icon">{{ cat_emoji }}</span>
                      {% endif %}
                      {{ section.settings[ch_key] }}
                    </label>
                  </div>
                {% endif %}
              {% endfor %}
            </div>

            <div class="srf__field" id="srf_model_field">
              <label class="srf__label" for="srf_model">{{ section.settings.s1_model_label | default: 'Product model / series' }} <span class="srf__required">*</span></label>
              <div class="srf__select-wrap">
                <select class="srf__select" id="srf_model" name="srf_model">
                  <option value="">{{ section.settings.s1_model_placeholder | default: '— Select a category first —' }}</option>
                </select>
              </div>
              <div class="srf__field-error" id="srf_model_error">{{ section.settings.s1_error_model | default: 'Please select a product model.' }}</div>
            </div>

            <div class="srf__buttons">
              <button type="button" class="srf__btn srf__btn--primary" data-next="2">{{ section.settings.s1_next_btn | default: 'Next →' }}</button>
            </div>
          </div>

          <!-- ══════════════════════════════════════════
               STAGE 2 — Problem Selection
          ══════════════════════════════════════════ -->
          <div class="srf__stage" data-stage="2">
            <h2 class="srf__stage-title">{{ section.settings.s2_title | default: 'Describe the Problem' }}</h2>
            <p class="srf__stage-desc">{{ section.settings.s2_desc | default: 'Select all issues that apply. Multiple selections are allowed.' }}</p>

            <div class="srf__stage-error" id="srf_error_2">{{ section.settings.s2_error | default: 'Please describe the problem in the text field below.' }}</div>

            <div class="srf__problem-groups">
              {% for block in section.blocks %}
                {% if block.type == 'problem' %}
                  {% assign assign_cats = block.settings.assign_categories | strip %}
                  <div class="srf__problem-group{% if forloop.first %} is-open{% endif %}"
                       data-assign-categories="{{ assign_cats | escape }}"
                       {{ block.shopify_attributes }}>
                    <div class="srf__group-toggle">
                      {{ block.settings.heading }}
                      <svg viewBox="0 0 10 6" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M1 1l4 4 4-4"/></svg>
                    </div>
                    <div class="srf__group-body">
                      {% for j in (1..20) %}
                        {% assign p_key = 'p' | append: j %}
                        {% assign p_val = block.settings[p_key] %}
                        {% if p_val != blank %}
                          <label class="srf__check-item"><input type="checkbox" name="srf_problems[]" value="{{ p_val | escape }}"> {{ p_val }}</label>
                        {% endif %}
                      {% endfor %}
                    </div>
                  </div>
                {% endif %}
              {% endfor %}
            </div>

            <div class="srf__field">
              <label class="srf__label" for="srf_description">
                {{ section.settings.s2_desc_label | default: 'Problem description' }} <span class="srf__required">*</span>
              </label>
              <textarea
                class="srf__textarea"
                id="srf_description"
                name="srf_description"
                placeholder="{{ section.settings.s2_desc_placeholder | default: 'Please describe the problem in as much detail as possible — when it occurred, what you observed, steps already taken, etc.' | escape }}"
              ></textarea>
              <div class="srf__field-error" id="srf_desc_error">{{ section.settings.s2_desc_error | default: 'Please describe the problem.' }}</div>
            </div>

            <div class="srf__buttons">
              <button type="button" class="srf__btn srf__btn--secondary" data-back="1">{{ section.settings.s2_back_btn | default: '← Back' }}</button>
              <button type="button" class="srf__btn srf__btn--primary" data-next="3">{{ section.settings.s2_next_btn | default: 'Next →' }}</button>
            </div>
          </div>

          <!-- ══════════════════════════════════════════
               STAGE 3 — Customer & Case Information
          ══════════════════════════════════════════ -->
          <div class="srf__stage" data-stage="3">
            <h2 class="srf__stage-title">{{ section.settings.s3_title | default: 'Your Information' }}</h2>
            <p class="srf__stage-desc">{{ section.settings.s3_desc | default: 'All fields marked with * are required to process your request.' }}</p>

            <div class="srf__stage-error" id="srf_error_3">{{ section.settings.s3_error | default: 'Please fill in all required fields.' }}</div>

            <div class="srf__info-grid">

              <div class="srf__field">
                <label class="srf__label" for="srf_name">{{ section.settings.s3_name_label | default: 'Full name' }} <span class="srf__required">*</span></label>
                <input class="srf__input" type="text" id="srf_name" name="srf_name" autocomplete="name">
                <div class="srf__field-error" id="srf_name_error">{{ section.settings.s3_name_error | default: 'Name is required.' }}</div>
              </div>

              <div class="srf__field">
                <label class="srf__label" for="srf_company">{{ section.settings.s3_company_label | default: 'Company name' }}</label>
                <input class="srf__input" type="text" id="srf_company" name="srf_company" autocomplete="organization">
              </div>

              <div class="srf__field">
                <label class="srf__label" for="srf_email">{{ section.settings.s3_email_label | default: 'Email address' }} <span class="srf__required">*</span></label>
                <input class="srf__input" type="email" id="srf_email" name="srf_email" autocomplete="email">
                <div class="srf__field-error" id="srf_email_error">{{ section.settings.s3_email_error | default: 'A valid email address is required.' }}</div>
              </div>

              <div class="srf__field">
                <label class="srf__label" for="srf_phone">{{ section.settings.s3_phone_label | default: 'Phone number' }} <span class="srf__required">*</span></label>
                <input class="srf__input" type="tel" id="srf_phone" name="srf_phone" autocomplete="tel">
                <div class="srf__field-error" id="srf_phone_error">{{ section.settings.s3_phone_error | default: 'Phone number is required.' }}</div>
              </div>

              <div class="srf__field col-full">
                <label class="srf__label" for="srf_address">{{ section.settings.s3_address_label | default: 'Full address' }} <span class="srf__required">*</span></label>
                <input class="srf__input" type="text" id="srf_address" name="srf_address" autocomplete="street-address" placeholder="{{ section.settings.s3_address_placeholder | default: 'Street, city, postal code, country' | escape }}">
                <div class="srf__field-error" id="srf_address_error">{{ section.settings.s3_address_error | default: 'Address is required.' }}</div>
              </div>

              <div class="srf__field">
                <label class="srf__label" for="srf_order">{{ section.settings.s3_order_label | default: 'Order number' }} <span class="srf__required">*</span></label>
                <input class="srf__input" type="text" id="srf_order" name="srf_order" placeholder="{{ section.settings.s3_order_placeholder | default: 'e.g. #1234' | escape }}">
                <div class="srf__field-error" id="srf_order_error">{{ section.settings.s3_order_error | default: 'Order number is required.' }}</div>
              </div>

              <div class="srf__field">
                <label class="srf__label" for="srf_serial">{{ section.settings.s3_serial_label | default: 'Serial number' }} <span class="srf__required">*</span></label>
                <input class="srf__input" type="text" id="srf_serial" name="srf_serial" placeholder="{{ section.settings.s3_serial_placeholder | default: 'Found on product label' | escape }}">
                <div class="srf__field-error" id="srf_serial_error">{{ section.settings.s3_serial_error | default: 'Serial number is required.' }}</div>
              </div>

              <div class="srf__field col-full">
                <label class="srf__label">{{ section.settings.s3_photos_label | default: 'Photos & videos' }}</label>
                <div class="srf__file-drop">
                  <input type="file" id="srf_photos" name="srf_photos" accept="image/*,video/*" multiple>
                  <div class="srf__file-drop-text">
                    <strong>{{ section.settings.s3_photos_upload | default: 'Click to upload photos & videos' }}</strong>
                    {{ section.settings.s3_photos_hint | default: 'Images and videos — multiple files allowed' }}
                  </div>
                  <div class="srf__file-previews" id="srf_file_names"></div>
                </div>
                <p style="font-size:12px;color:#888;margin-top:6px;">{{ section.settings.s3_photos_note | default: 'Files upload automatically when you submit. Images & videos supported.' }}</p>
              </div>

              <div class="srf__field col-full">
                <label class="srf__label" for="srf_drive_link">{{ section.settings.s3_drive_label | default: 'Or paste a Google Drive / cloud link' }} <span style="font-weight:400;opacity:.6;">(optional)</span></label>
                <input
                  class="srf__input"
                  type="url"
                  id="srf_drive_link"
                  name="srf_drive_link"
                  placeholder="{{ section.settings.s3_drive_placeholder | default: 'https://drive.google.com/...' | escape }}"
                >
                <p style="font-size:12px;color:#888;margin-top:6px;">
                  {{ section.settings.s3_drive_note | default: 'If you already have files on Google Drive — set sharing to <strong>Anyone with the link</strong> and paste it here.' }}
                </p>
              </div>

            </div>

            {% if section.settings.consent_text != blank %}
              <div class="srf__field col-full srf__consent-wrap">
                <label class="srf__consent-label">
                  <input type="checkbox" id="srf_consent" name="srf_consent">
                  <span>{{ section.settings.consent_text }}</span>
                </label>
                <div class="srf__field-error" id="srf_consent_error">{{ section.settings.consent_error | default: 'You must accept the terms before submitting.' }}</div>
              </div>
            {% endif %}

            <div class="srf__buttons">
              <button type="button" class="srf__btn srf__btn--secondary" data-back="2">{{ section.settings.s3_back_btn | default: '← Back' }}</button>
              <button type="submit" class="srf__btn srf__btn--primary" id="srf_submit" data-uploading="{{ section.settings.s3_uploading_text | default: 'Uploading…' | escape }}">{{ section.settings.s3_submit_btn | default: 'Submit Request' }}</button>
            </div>
          </div>

        {% endif %}
      {% endform %}

    </div>
  </div>
</section>

<script>
(function () {
  var section = document.getElementById('srf--{{ section.id }}');
  if (!section) return;

  var current = 1;
  var modelPlaceholder2 = {{ section.settings.s1_model_placeholder_2 | default: '— Select model —' | json }};

  function goTo(stage) {
    section.querySelectorAll('.srf__stage').forEach(function (el) {
      el.classList.remove('is-active');
    });
    var target = section.querySelector('[data-stage="' + stage + '"]');
    if (target) target.classList.add('is-active');

    section.querySelectorAll('.srf__progress-step').forEach(function (el) {
      var s = parseInt(el.dataset.step, 10);
      el.classList.toggle('is-done', s < stage);
      el.classList.toggle('is-active', s === stage);
    });

    var fill = section.querySelector('#srf_progress_fill');
    if (fill) fill.style.width = (stage - 1) * 50 + '%';

    current = stage;
    window.scrollTo({ top: section.offsetTop - 20, behavior: 'smooth' });
  }

  /* ── Category filter for problem groups ── */
  function filterProblemGroups(categoryName) {
    section.querySelectorAll('.srf__problem-group').forEach(function (group) {
      var assignCats = (group.dataset.assignCategories || '').trim();
      if (!assignCats) {
        group.style.display = '';
        return;
      }
      var cats = assignCats.split(',').map(function (c) { return c.trim().toLowerCase(); });
      group.style.display = cats.indexOf(categoryName.toLowerCase()) !== -1 ? '' : 'none';
    });
  }

  /* ── Model dropdown from data-models attribute ── */
  var modelSelect = section.querySelector('#srf_model');
  section.querySelectorAll('input[name="srf_category"]').forEach(function (radio) {
    radio.addEventListener('change', function () {
      var list = (this.dataset.models || '').split('|').filter(Boolean);
      modelSelect.innerHTML = '<option value="">' + modelPlaceholder2 + '</option>';
      list.forEach(function (m) {
        var opt = document.createElement('option');
        opt.value = m;
        opt.textContent = m;
        modelSelect.appendChild(opt);
      });
      modelSelect.disabled = false;
      filterProblemGroups(this.value);
    });
  });

  /* ── Accordion toggles ── */
  section.querySelectorAll('.srf__group-toggle').forEach(function (toggle) {
    toggle.addEventListener('click', function () {
      this.closest('.srf__problem-group').classList.toggle('is-open');
    });
  });

  /* ── File select → preview only ── */
  var photoInput = section.querySelector('#srf_photos');
  var selectedFiles = [];

  if (photoInput) {
    photoInput.addEventListener('change', function () {
      var display = section.querySelector('#srf_file_names');
      Array.from(this.files).forEach(function (f) {
        var idx = selectedFiles.length;
        selectedFiles.push(f);
        var isVideo = f.type.startsWith('video/');
        var item = document.createElement('div');
        item.className = 'srf__preview-item';
        item.innerHTML =
          '<button type="button" class="srf__preview-remove" aria-label="Remove">×</button>' +
          (isVideo
            ? '<div class="srf__preview-thumb">🎬</div>'
            : '<img src="' + URL.createObjectURL(f) + '" alt="' + f.name + '">') +
          '<span class="srf__preview-name">' + f.name + '</span>' +
          '<div class="srf__upload-status"></div>';
        item.querySelector('.srf__preview-remove').addEventListener('click', function () {
          selectedFiles[idx] = null;
          item.remove();
        });
        if (display) display.appendChild(item);
      });
      this.value = '';
    });
  }

  /* ── Validation ── */
  function showError(id, show) {
    var el = section.querySelector('#' + id);
    if (el) el.style.display = show ? 'block' : 'none';
  }

  function markField(id, invalid) {
    var el = section.querySelector('#' + id);
    if (el) el.classList.toggle('has-error', invalid);
  }

  function validateStage1() {
    var cat = section.querySelector('input[name="srf_category"]:checked');
    var model = section.querySelector('#srf_model');
    var ok = true;

    if (!cat) {
      showError('srf_error_1', true);
      ok = false;
    } else {
      showError('srf_error_1', false);
    }

    if (cat && (!model || !model.value)) {
      markField('srf_model', true);
      showError('srf_model_error', true);
      ok = false;
    } else {
      markField('srf_model', false);
      showError('srf_model_error', false);
    }

    return ok;
  }

  function validateStage2() {
    var desc = section.querySelector('#srf_description');
    var ok = true;

    if (!desc || !desc.value.trim()) {
      markField('srf_description', true);
      showError('srf_desc_error', true);
      showError('srf_error_2', true);
      ok = false;
    } else {
      markField('srf_description', false);
      showError('srf_desc_error', false);
      showError('srf_error_2', false);
    }

    return ok;
  }

  function validateStage3() {
    var fields = [
      { id: 'srf_name',    errId: 'srf_name_error',    check: function (v) { return v.trim().length > 0; } },
      { id: 'srf_email',   errId: 'srf_email_error',   check: function (v) { return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v); } },
      { id: 'srf_phone',   errId: 'srf_phone_error',   check: function (v) { return v.trim().length > 0; } },
      { id: 'srf_address', errId: 'srf_address_error', check: function (v) { return v.trim().length > 0; } },
      { id: 'srf_order',   errId: 'srf_order_error',   check: function (v) { return v.trim().length > 0; } },
      { id: 'srf_serial',  errId: 'srf_serial_error',  check: function (v) { return v.trim().length > 0; } }
    ];
    var ok = true;

    fields.forEach(function (f) {
      var el = section.querySelector('#' + f.id);
      var valid = el && f.check(el.value);
      markField(f.id, !valid);
      showError(f.errId, !valid);
      if (!valid) ok = false;
    });

    var consentBox = section.querySelector('#srf_consent');
    if (consentBox && !consentBox.checked) {
      showError('srf_consent_error', true);
      ok = false;
    } else if (consentBox) {
      showError('srf_consent_error', false);
    }

    showError('srf_error_3', !ok);
    return ok;
  }

  /* ── Navigation ── */
  section.addEventListener('click', function (e) {
    var next = e.target.closest('[data-next]');
    var back = e.target.closest('[data-back]');

    if (next) {
      var to = parseInt(next.dataset.next, 10);
      var valid = (to === 2 && validateStage1()) || (to === 3 && validateStage2());
      if (valid) goTo(to);
    }

    if (back) {
      goTo(parseInt(back.dataset.back, 10));
    }
  });

  /* ── Build & submit ── */
  var form = section.querySelector('form');
  if (form) {
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      if (!validateStage3()) return;

      var filesToUpload = selectedFiles.filter(Boolean);
      var submitBtn = section.querySelector('#srf_submit');

      function buildAndSubmit(cloudinaryFiles) {
        var cat     = section.querySelector('input[name="srf_category"]:checked');
        var model   = section.querySelector('#srf_model');
        var desc    = section.querySelector('#srf_description');
        var name    = section.querySelector('#srf_name');
        var email   = section.querySelector('#srf_email');
        var phone   = section.querySelector('#srf_phone');
        var company = section.querySelector('#srf_company');
        var address = section.querySelector('#srf_address');
        var order   = section.querySelector('#srf_order');
        var serial  = section.querySelector('#srf_serial');
        var drive   = section.querySelector('#srf_drive_link');

        var orderVal  = order  ? order.value.trim() : '';
        var modelVal  = model  ? model.value        : '';
        var catVal    = cat    ? cat.value           : '';
        var driveLink = drive  && drive.value.trim() ? drive.value.trim() : '';

        var problemGroups = [];
        section.querySelectorAll('.srf__problem-group').forEach(function (group) {
          var toggle = group.querySelector('.srf__group-toggle');
          var headingText = '';
          if (toggle) {
            toggle.childNodes.forEach(function (node) {
              if (node.nodeType === 3) headingText += node.textContent;
            });
            headingText = headingText.trim();
          }
          var checkedItems = Array.from(group.querySelectorAll('input[name="srf_problems[]"]:checked')).map(function (c) { return c.value; });
          if (checkedItems.length) {
            problemGroups.push({ heading: headingText || 'Other', items: checkedItems });
          }
        });

        section.querySelector('#srf_subject').value =
          'Service Request – ' + orderVal + ' – ' + modelVal + ' – ' + catVal;
        section.querySelector('#srf_name_hidden').value  = name  ? name.value  : '';
        section.querySelector('#srf_email_hidden').value = email ? email.value : '';

        var mediaLines = [];
        if (cloudinaryFiles.length) {
          cloudinaryFiles.forEach(function (f) { mediaLines.push(f.name + ': ' + f.url); });
        }
        if (driveLink) mediaLines.push('Google Drive: ' + driveLink);
        if (!mediaLines.length) mediaLines.push('No media provided.');

        var problemLines = ['--- Problems Reported ---', ''];
        if (problemGroups.length) {
          problemGroups.forEach(function (g) {
            problemLines.push(g.heading + ':');
            g.items.forEach(function (item) { problemLines.push('  • ' + item); });
            problemLines.push('');
          });
        } else {
          problemLines.push('None selected', '');
        }

        var lines = [
          '=== SERVICE REQUEST ===', '',
          '--- Product ---',
          'Category:     ' + catVal,
          'Model/Series: ' + modelVal, ''
        ].concat(problemLines).concat([
          '--- Description ---',
          desc ? desc.value : '', '',
          '--- Customer Information ---',
          'Name:         ' + (name    ? name.value    : ''),
          'Company:      ' + (company ? company.value : 'N/A'),
          'Email:        ' + (email   ? email.value   : ''),
          'Phone:        ' + (phone   ? phone.value   : ''),
          'Address:      ' + (address ? address.value : ''), '',
          '--- Order Details ---',
          'Order Number: ' + orderVal,
          'Serial Number:' + (serial  ? serial.value  : ''), '',
          '--- Media ---'
        ]).concat(mediaLines);

        section.querySelector('#srf_body').value = lines.join('\n');
        form.submit();
      }

      if (filesToUpload.length === 0) {
        buildAndSubmit([]);
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = submitBtn.dataset.uploading || 'Uploading…';
      }

      var cloudinaryFiles = [];
      var completed = 0;

      filesToUpload.forEach(function (f) {
        var statusEl = null;
        section.querySelectorAll('.srf__preview-name').forEach(function (el) {
          if (el.textContent === f.name) statusEl = el.nextElementSibling;
        });
        if (statusEl) statusEl.textContent = 'Uploading…';

        var fd = new FormData();
        fd.append('file', f);
        fd.append('upload_preset', 'ml_default');

        fetch('https://api.cloudinary.com/v1_1/dm4v7mwpw/auto/upload', { method: 'POST', body: fd })
          .then(function (r) { return r.json(); })
          .then(function (data) {
            if (data.secure_url) {
              cloudinaryFiles.push({ name: f.name, url: data.secure_url });
              if (statusEl) statusEl.textContent = '✓ Done';
            } else {
              if (statusEl) statusEl.textContent = '✗ Failed';
            }
          })
          .catch(function () {
            if (statusEl) statusEl.textContent = '✗ Failed';
          })
          .then(function () {
            completed++;
            if (completed === filesToUpload.length) buildAndSubmit(cloudinaryFiles);
          });
      });
    });
  }
})();
</script>

{% schema %}
{
  "name": "Service Request Form",
