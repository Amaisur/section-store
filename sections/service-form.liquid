    },
    {
      "type": "textarea",
      "id": "confirm_message",
      "label": "Success message",
      "default": "Thank you. Your service request has been received. Our support team will review your case and contact you as soon as possible. Please note that incomplete or unclear information may delay processing."
    },
    {
      "type": "header",
      "content": "Progress Steps"
    },
    {
      "type": "text",
      "id": "step_1_label",
      "label": "Step 1 label",
      "default": "Product"
    },
    {
      "type": "text",
      "id": "step_2_label",
      "label": "Step 2 label",
      "default": "Problem"
    },
    {
      "type": "text",
      "id": "step_3_label",
      "label": "Step 3 label",
      "default": "Details"
    },
    {
      "type": "header",
