{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}
<!-- Add this to your cart page or cart drawer -->
<div class="discount-input">
  <input type="text" 
         id="discount-code" 
         placeholder="Enter discount code"
         class="discount-input-field">
  <button id="apply-discount" class="discount-button">Apply</button>
  <div id="discount-message" class="discount-message"></div>
  
  <div id="active-discounts" class="active-discounts">
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const discountInput = document.getElementById('discount-code');
  const applyButton = document.getElementById('apply-discount');
  const messageDiv = document.getElementById('discount-message');
  const activeDiscountsDiv = document.getElementById('active-discounts');
  
  loadCartDiscounts();
  
  if (applyButton && discountInput) {
    applyButton.addEventListener('click', applyDiscount);
    discountInput.addEventListener('keypress', function(e) {
      if (e.key === 'Enter') applyDiscount();
    });
  }
  
  function loadCartDiscounts() {
    fetch('/cart.js')
      .then(response => response.json())
      .then(cart => {
        updateActiveDiscounts(cart);
      })
      .catch(error => {
        console.error(error);
      });
  }
  
  function updateActiveDiscounts(cart) {
    activeDiscountsDiv.innerHTML = '';
    
    if (cart.discounts && cart.discounts.length > 0) {
      cart.discounts.forEach(discount => {
        const discountItem = document.createElement('div');
        discountItem.className = 'active-discount-item';
        discountItem.innerHTML = `
          <span class="discount-code-text">${discount.code}</span>
          <span class="discount-amount">-${Shopify.formatMoney(discount.amount, window.money_format || '{{ shop.money_format }}')}</span>
          <button class="remove-discount-btn" data-code="${discount.code}">Remove</button>
        `;
        activeDiscountsDiv.appendChild(discountItem);
      });
      
      const removeButtons = activeDiscountsDiv.querySelectorAll('.remove-discount-btn');
      removeButtons.forEach(button => {
        button.addEventListener('click', function() {
          const codeToRemove = this.getAttribute('data-code');
          removeDiscount(codeToRemove);
        });
      });
    }
  }
  
  function applyDiscount() {
    const discountCode = discountInput.value.trim();
    
    if (!discountCode) {
      showMessage('Please enter a discount code', 'error');
      return;
    }
    
    applyButton.textContent = 'Applying...';
    applyButton.disabled = true;
    
    const payload = {
      discount: discountCode
    };
    
    fetch('/cart/update.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(payload)
    })
    .then(response => response.json())
    .then(data => {
      if (data.errors) {
        const errorMsg = data.errors.discount || 'Invalid discount code';
        showMessage(errorMsg, 'error');
      } else {
        showMessage('Discount applied successfully!', 'success');
        discountInput.value = '';
        updateActiveDiscounts(data);
        setTimeout(() => {
          window.location.reload();
        }, 1000);
      }
    })
    .catch(error => {
      console.error(error);
      showMessage('An error occurred. Please try again.', 'error');
    })
    .finally(() => {
      applyButton.textContent = 'Apply';
      applyButton.disabled = false;
    });
  }
  
  function removeDiscount(code) {
    const removeButton = event?.target || document.querySelector(`[data-code="${code}"]`);
    
    if (removeButton) {
      removeButton.textContent = 'Removing...';
      removeButton.disabled = true;
    }
    
    fetch('/cart/update.js', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
      },
      body: JSON.stringify({ discount: "" })
    })
    .then(response => response.json())
    .then(data => {
      if (data.errors) {
        showMessage('Failed to remove discount', 'error');
      } else {
        showMessage('Discount removed successfully!', 'success');
        updateActiveDiscounts(data);
        setTimeout(() => {
          window.location.reload();
        }, 1000);
      }
    })
    .catch(error => {
      console.error(error);
      showMessage('An error occurred. Please try again.', 'error');
    })
    .finally(() => {
      if (removeButton) {
        removeButton.textContent = 'Remove';
        removeButton.disabled = false;
      }
    });
  }
  
  function showMessage(message, type) {
    messageDiv.textContent = message;
    messageDiv.className = `discount-message ${type}`;
    
    setTimeout(() => {
      messageDiv.textContent = '';
      messageDiv.className = 'discount-message';
    }, 5000);
  }
});
</script>

<style>
.discount-input {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin: 20px 0;
}

.discount-input-field {
  padding: 10px;
  border: 1px solid #ddd;
  border-radius: 4px;
  font-size: 14px;
}

.discount-button {
  padding: 10px 20px;
  background-color: #000;
  color: #fff;
  border: none;
  border-radius: 4px;
  cursor: pointer;
  font-size: 14px;
}

.discount-button:hover:not(:disabled) {
  background-color: #333;
}

.discount-button:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

.discount-message {
  padding: 8px;
  border-radius: 4px;
  font-size: 14px;
}

.discount-message.success {
  background-color: #d4edda;
  color: #155724;
  border: 1px solid #c3e6cb;
}

.discount-message.error {
  background-color: #f8d7da;
  color: #721c24;
  border: 1px solid #f5c6cb;
}

.active-discounts {
  margin-top: 10px;
}

.active-discount-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px 12px;
  background-color: #f8f9fa;
  border: 1px solid #e9ecef;
  border-radius: 4px;
  margin-bottom: 5px;
}

.discount-code-text {
  font-weight: bold;
  color: #28a745;
}

.discount-amount {
  color: #dc3545;
  font-weight: 500;
}

.remove-discount-btn {
  padding: 4px 8px;
  background-color: #6c757d;
  color: white;
  border: none;
  border-radius: 3px;
  cursor: pointer;
  font-size: 12px;
}

.remove-discount-btn:hover:not(:disabled) {
  background-color: #5a6268;
}

.remove-discount-btn:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}
</style>
<div
  class="gradient color-{{ section.settings.color_scheme }}{% if cart == empty %} is-empty{% endif %}"
  id="main-cart-footer"
  data-id="{{ section.id }}"
>
  <div class="page-width">
    <div class="cart__footer isolate section-{{ section.id }}-padding">
      {%- if settings.show_cart_note -%}
        <cart-note class="cart__note field">
          <label for="Cart-note">{{ 'sections.cart.note' | t }}</label>
          <textarea
            class="text-area field__input"
            name="note"
            form="cart"
            id="Cart-note"
            placeholder="{{ 'sections.cart.note' | t }}"
          >{{ cart.note }}</textarea>
        </cart-note>
      {%- endif -%}

      <div class="cart__blocks">
        {% for block in section.blocks %}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}
            {%- when 'subtotal' -%}
              <div class="js-contents" {{ block.shopify_attributes }}>
                <div>
                  {%- if cart.cart_level_discount_applications.size > 0 -%}
                    <ul class="discounts list-unstyled" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                      {%- for discount in cart.cart_level_discount_applications -%}
                        <li class="discounts__discount discounts__discount--position" remove-discount-d5>
                          {%- render 'icon-discount' -%}
                          {{ discount.title }}
                          (-{{ discount.total_allocated_amount | money }})
                        </li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}
                </div>

                <div class="totals">
                  <h2 class="totals__total">{{ 'sections.cart.estimated_total' | t }}</h2>
                  <p class="totals__total-value">{{ cart.total_price | money_with_currency }}</p>
                </div>

                <small class="tax-note caption-large rte">
                  {%- if cart.taxes_included and shop.shipping_policy.body != blank -%}
                    {{ 'sections.cart.taxes_included_and_shipping_policy_html' | t: link: shop.shipping_policy.url }}
                  {%- elsif cart.taxes_included -%}
                    {{ 'sections.cart.taxes_included_but_shipping_at_checkout' | t }}
                  {%- elsif shop.shipping_policy.body != blank -%}
                    {{ 'sections.cart.taxes_and_shipping_policy_at_checkout_html' | t: link: shop.shipping_policy.url }}
                  {%- else -%}
                    {{ 'sections.cart.taxes_and_shipping_at_checkout' | t }}
                  {%- endif -%}
                </small>
              </div>
            {%- else -%}
              <div class="cart__ctas" {{ block.shopify_attributes }}>
                <noscript>
                  <button type="submit" class="cart__update-button button button--secondary" form="cart">
                    {{ 'sections.cart.update' | t }}
                  </button>
                </noscript>

                <button
                  type="submit"
                  id="checkout"
                  class="cart__checkout-button button"
                  name="checkout"
                  {% if cart == empty %}
                    disabled
                  {% endif %}
                  form="cart"
                >
                  {{ 'sections.cart.checkout' | t }}
                </button>
              </div>

              {%- if additional_checkout_buttons -%}
                <div class="cart__dynamic-checkout-buttons additional-checkout-buttons">
                  {{ content_for_additional_checkout_buttons }}
                </div>
              {%- endif -%}
          {%- endcase -%}
        {% endfor %}

        <div id="cart-errors"></div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    function isIE() {
      const ua = window.navigator.userAgent;
      const msie = ua.indexOf('MSIE ');
      const trident = ua.indexOf('Trident/');

      return msie > 0 || trident > 0;
    }

    if (!isIE()) return;
    const cartSubmitInput = document.createElement('input');
    cartSubmitInput.setAttribute('name', 'checkout');
    cartSubmitInput.setAttribute('type', 'hidden');
    document.querySelector('#cart').appendChild(cartSubmitInput);
    document.querySelector('#checkout').addEventListener('click', function (event) {
      document.querySelector('#cart').submit();
    });
  });
</script>

{% schema %}
{
  "name": "t:sections.main-cart-footer.name",
  "class": "cart__footer-wrapper",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "t:sections.all.padding.padding_bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "subtotal",
      "name": "t:sections.main-cart-footer.blocks.subtotal.name",
      "limit": 1
    },
    {
      "type": "buttons",
      "name": "t:sections.main-cart-footer.blocks.buttons.name",
      "limit": 1
    },
    {
      "type": "@app"
    }
  ]
}
{% endschema %}
